# 后端环境变量示例（复制为 .env 后填写）
COMFY_CONSOLE_DEBUG=true
COMFY_CONSOLE_SHORT_DRAMA_ENABLED=true
COMFY_CONSOLE_STORY_WORKER_POLL_SECONDS=1
COMFY_CONSOLE_STORY_WORKER_TIMEOUT_SECONDS=300
COMFY_CONSOLE_STORY_WORKER_MAX_RETRIES=2
COMFY_CONSOLE_DATABASE_URL=sqlite:///./data/app.db
COMFY_CONSOLE_STORAGE_PATH=./data/resources
# 生产环境必须使用固定随机值；修改后，已保存的 AI API Key 将无法解密。
COMFY_CONSOLE_SECRET_KEY=change-me-in-production
